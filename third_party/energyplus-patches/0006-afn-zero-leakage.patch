+        // Vulcan patch 0006: zero-leakage envelopes.
+        // A group of unknown-pressure nodes with no conducting link to a known-pressure (external) node has a
+        // singular Jacobian: its flows fix pressure differences but not the level. Every link leaving such a group
+        // has a zero flow derivative, so its flow does not depend on the group's pressures. When those flows sum to
+        // zero, the group's residuals sum to zero, and adding any positive value to one diagonal entry fixes that
+        // node's correction to zero while every flow stays exact. When they do not sum to zero (a fan or specified
+        // flow drives net air into a sealed group), no solution exists and the run stops. Groups that reach a
+        // known-pressure node are left unchanged, so models without sealed groups give unchanged results.
+        {
+            std::vector<char> groupReachesKnownPressure(NetworkNumOfNodes + 1, 0);
+            for (n = 1; n <= NetworkNumOfNodes; ++n) {
+                if (AirflowNetworkNodeData(n).NodeTypeNum == 1) {
+                    groupReachesKnownPressure[findGroup(n)] = 1;
+                }
+            }
+            std::vector<int> groupDatumNode(NetworkNumOfNodes + 1, 0);
+            bool anySealedGroup = false;
+            for (n = 1; n <= NetworkNumOfNodes; ++n) {
+                int const group = findGroup(n);
+                if (AirflowNetworkNodeData(n).NodeTypeNum == 0 && !groupReachesKnownPressure[group] && groupDatumNode[group] == 0) {
+                    groupDatumNode[group] = n;
+                    AD(n) += 1.0;
+                    anySealedGroup = true;
+                }
+            }
+            if (anySealedGroup) {
+                std::vector<Real64> groupNetInflow(NetworkNumOfNodes + 1, 0.0);
+                for (i = 1; i <= NetworkNumOfLinks; ++i) {
+                    if (AirflowNetworkLinkageData(i).element == nullptr) {
+                        continue;
+                    }
+                    int const groupFrom = findGroup(AirflowNetworkLinkageData(i).NodeNums[0]);
+                    int const groupTo = findGroup(AirflowNetworkLinkageData(i).NodeNums[1]);
+                    if (groupFrom != groupTo) {
+                        groupNetInflow[groupFrom] -= datumLinkFlow[i];
+                        groupNetInflow[groupTo] += datumLinkFlow[i];
+                    }
+                }
+                for (n = 1; n <= NetworkNumOfNodes; ++n) {
+                    int const datumNode = groupDatumNode[n];
+                    if (datumNode != 0 && std::abs(groupNetInflow[n]) > simulation_control.absolute_convergence_tolerance) {
+                        ShowSevereError(m_state, "AirflowNetwork: a group of zones has no airflow path to outdoors, and its fans and specified flows do not balance.");
+                        ShowContinueError(m_state,
+                                          EnergyPlus::format("The group includes node {}; its net fixed inflow is {:.6R} kg/s, and no pressure can balance it.",
+                                                             AirflowNetworkNodeData(datumNode).Name,
+                                                             groupNetInflow[n]));
+                        ShowContinueError(m_state, "Add an opening or leakage path to outdoors, or balance the fans and specified flows in the group.");
+                        ShowContinueErrorTimeStamp(m_state, "");
+                        ShowFatalError(m_state, "Preceding condition causes termination.");
+                    }
+                }
+            }
+        }
